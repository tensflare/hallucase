{
  "name": "hallucase",
  "version": "0.1.0",
  "description": "The Legal AI Hallucination Registry — track, reproduce, and prevent legal AI hallucinations",
  "type": "module",
  "bin": {
    "hallucase": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^12.0.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "zod": "^3.22.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensflare/hallucase.git"
  },
  "homepage": "https://github.com/tensflare/hallucase#readme",
  "bugs": {
    "url": "https://github.com/tensflare/hallucase/issues"
  },
  "keywords": ["legal", "ai", "hallucination", "registry", "cve", "contracts"],
  "author": "Tensflare Inc.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
