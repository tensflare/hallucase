# HalluCase — Environment Configuration

# Server
PORT=3457

# SQLite (default)
DATABASE_PATH=./hallucase.db

# TiDB Cloud (set TIDB_HOST or DATABASE_URL to use TiDB instead of SQLite)
# TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=root
# TIDB_PASSWORD=your-password
# TIDB_DATABASE=hallucase
# DATABASE_URL=mysql://root:password@host:4000/hallucase?ssl={"rejectUnauthorized":true}
